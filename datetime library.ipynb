   "source": [
    "import random\n",
    "nums = []\n",
    "for x in range(10):\n",
    "    y = random.randint(1,6)\n",
    "    nums.append(y)\n",
    "print(nums)\n",
    "print(\"lowest\", min(nums))\n",
    "print(\"highest\",max(nums))\n",
    "print(\"number of sixes\",nums.count(6))"
   ]
